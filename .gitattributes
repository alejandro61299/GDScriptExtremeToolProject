# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Release archives and Asset Library downloads only contain the addon.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/CHANGELOG.md export-ignore
/EXTRACT_VARIABLE_PLAN.md export-ignore
/FUNCTIONS_IN_OTHER_SCRIPTS_PLAN.md export-ignore
/LICENSE export-ignore
/PRELOAD_TYPES_PLAN.md export-ignore
/README.md export-ignore
/icon.png export-ignore
/icon.png.import export-ignore
/icon.svg export-ignore
/icon.svg.import export-ignore
/project.godot export-ignore
/tests export-ignore
/tools export-ignore
